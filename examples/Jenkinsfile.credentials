// Using credentials safely. Always single-quote sh commands that use secrets,
// so the shell expands them instead of Groovy interpolating them.
pipeline {
    agent any

    environment {
        // Username/password credential -> DOCKER_CREDS_USR and DOCKER_CREDS_PSW
        DOCKER_CREDS = credentials('dockerhub-creds')
    }

    stages {
        stage('Docker Login') {
            steps {
                sh 'echo "$DOCKER_CREDS_PSW" | docker login -u "$DOCKER_CREDS_USR" --password-stdin'
            }
        }

        stage('Other Secret Types') {
            steps {
                withCredentials([string(credentialsId: 'api-token', variable: 'TOKEN')]) {
                    sh 'curl -s -H "Authorization: Bearer $TOKEN" https://api.example.com/health'
                }

                withCredentials([sshUserPrivateKey(credentialsId: 'deploy-key', keyFileVariable: 'KEY', usernameVariable: 'USER')]) {
                    sh 'ssh -i "$KEY" -o StrictHostKeyChecking=no "$USER"@server.example.com "uptime"'
                }

                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh 'kubectl get pods'
                }
            }
        }
    }
}
