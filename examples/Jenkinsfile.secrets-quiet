// Secrets done right: single quotes + set +x to keep commands out of the log
pipeline {
    agent any

    stages {
        stage('Secrets Done Right') {
            steps {
                withCredentials([string(credentialsId: 'api-token', variable: 'TOKEN')]) {

                    // WRONG: Groovy interpolates the secret into the command string
                    // sh "curl -H 'Authorization: Bearer ${TOKEN}' https://api.example.com"

                    // RIGHT: single quotes, the shell expands the variable
                    sh 'curl -s -H "Authorization: Bearer $TOKEN" https://api.example.com'
                }
            }
        }

        stage('Quiet Secret Use') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'db-creds',
                                                  usernameVariable: 'DB_USER',
                                                  passwordVariable: 'DB_PASS')]) {
                    sh '''
                        set +x
                        export PGPASSWORD="$DB_PASS"
                        psql -h db.example.com -U "$DB_USER" -c "SELECT 1;"
                    '''
                }
            }
        }
    }
}
